// The launcher's icon (launcher/make_icon.py draws it) and version information (VCS_VERSION_*: VERSION in the
// repository root, through launcher/CMakeLists.txt).
#include <winver.h>

1 ICON "launcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VCS_VERSION_MAJOR, VCS_VERSION_MINOR, VCS_VERSION_PATCH, 0
PRODUCTVERSION VCS_VERSION_MAJOR, VCS_VERSION_MINOR, VCS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GTA: Vice City Stories PC port - launcher"
            VALUE "ProductName", "VCS Recomp"
            VALUE "OriginalFilename", "VCSLauncher.exe"
            VALUE "FileVersion", VCS_VERSION_TEXT
            VALUE "ProductVersion", VCS_VERSION_TEXT
            VALUE "LegalCopyright", "GPL-3.0. Unofficial; Grand Theft Auto is property of Rockstar Games / Take-Two Interactive"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
